# Скопируйте этот файл в .env и заполните реальными значениями
# НИКОГДА не коммитьте .env в git (добавьте его в .gitignore)

# PostgreSQL (из Neon.tech / Supabase — там сразу дают готовую строку подключения)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Секрет для подписи JWT-токенов — сгенерируйте случайную длинную строку
# Например: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=замените_на_случайную_длинную_строку

# VAPID-ключи для Web Push — сгенерируйте командой:
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Порт сервера (Render подставит свой автоматически через process.env.PORT)
PORT=3000

# Домен фронтенда, чтобы настроить CORS (например, https://yoursite.com)
FRONTEND_ORIGIN=http://localhost:5500
